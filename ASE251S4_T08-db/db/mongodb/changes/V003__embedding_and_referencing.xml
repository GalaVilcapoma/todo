<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd
                        http://www.liquibase.org/xml/ns/mongodb
                        https://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <!-- ============================================================
         EMBEDDING â€” colecciones y validadores
         ============================================================ -->

    <changeSet id="V003-01" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="productos_v2"/></not>
        </preConditions>
        <comment>EMBEDDING: productos_v2 con subdocumento de atributos variables.</comment>
        <mongodb:createCollection collectionName="productos_v2">
            <mongodb:options><![CDATA[{
                "validator": {"$jsonSchema": {
                    "bsonType": "object",
                    "required": ["codigo", "nombre", "categoria", "precioUnitario", "atributos"],
                    "properties": {
                        "codigo":         {"bsonType": "string"},
                        "nombre":         {"bsonType": "string"},
                        "categoria":      {"bsonType": "string"},
                        "precioUnitario": {"bsonType": ["decimal", "double", "int"]},
                        "atributos":      {"bsonType": "object"},
                        "estado":         {"bsonType": "bool"}
                    }
                }},
                "validationLevel": "moderate"
            }]]></mongodb:options>
        </mongodb:createCollection>
        <rollback><mongodb:dropCollection collectionName="productos_v2"/></rollback>
    </changeSet>

    <changeSet id="V003-02" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="customer_v2"/></not>
        </preConditions>
        <comment>EMBEDDING: customer_v2 con contactos y direcciones embebidos.</comment>
        <mongodb:createCollection collectionName="customer_v2">
            <mongodb:options><![CDATA[{
                "validator": {"$jsonSchema": {
                    "bsonType": "object",
                    "required": ["codigo", "razonSocial", "pais", "tipoCliente"],
                    "properties": {
                        "codigo":      {"bsonType": "string"},
                        "razonSocial": {"bsonType": "string"},
                        "pais":        {"bsonType": "string"},
                        "tipoCliente": {"bsonType": "string", "enum": ["NACIONAL", "INTERNACIONAL"]},
                        "contactos":   {"bsonType": "array"},
                        "direccionesEntrega": {"bsonType": "array"},
                        "active":      {"bsonType": "bool"}
                    }
                }},
                "validationLevel": "moderate"
            }]]></mongodb:options>
        </mongodb:createCollection>
        <rollback><mongodb:dropCollection collectionName="customer_v2"/></rollback>
    </changeSet>

    <changeSet id="V003-03" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="notificaciones_v2"/></not>
        </preConditions>
        <comment>EMBEDDING: notificaciones_v2 con snapshot inmutable del evento.</comment>
        <mongodb:createCollection collectionName="notificaciones_v2"/>
        <rollback><mongodb:dropCollection collectionName="notificaciones_v2"/></rollback>
    </changeSet>

    <!-- ============================================================
         REFERENCING â€” colecciones y validadores
         ============================================================ -->

    <changeSet id="V003-04" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="fabricantes"/></not>
        </preConditions>
        <comment>REFERENCING: colecciÃ³n maestra fabricantes.</comment>
        <mongodb:createCollection collectionName="fabricantes">
            <mongodb:options><![CDATA[{
                "validator": {"$jsonSchema": {
                    "bsonType": "object",
                    "required": ["codigo", "nombre", "pais"],
                    "properties": {
                        "codigo": {"bsonType": "string"},
                        "nombre": {"bsonType": "string"},
                        "pais":   {"bsonType": "string"}
                    }
                }},
                "validationLevel": "moderate"
            }]]></mongodb:options>
        </mongodb:createCollection>
        <rollback><mongodb:dropCollection collectionName="fabricantes"/></rollback>
    </changeSet>

    <changeSet id="V003-05" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="agrochemicals_v2"/></not>
        </preConditions>
        <comment>REFERENCING: agrochemicals_v2 con fabricanteCodigo.</comment>
        <mongodb:createCollection collectionName="agrochemicals_v2">
            <mongodb:options><![CDATA[{
                "validator": {"$jsonSchema": {
                    "bsonType": "object",
                    "required": ["commercialName", "activeIngredient", "category", "fabricanteCodigo"],
                    "properties": {
                        "commercialName":   {"bsonType": "string"},
                        "activeIngredient": {"bsonType": "string"},
                        "category":         {"bsonType": "string"},
                        "fabricanteCodigo": {"bsonType": "string"},
                        "active":           {"bsonType": "bool"}
                    }
                }},
                "validationLevel": "moderate"
            }]]></mongodb:options>
        </mongodb:createCollection>
        <rollback><mongodb:dropCollection collectionName="agrochemicals_v2"/></rollback>
    </changeSet>

    <changeSet id="V003-06" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="pedidos_detalle"/></not>
        </preConditions>
        <comment>REFERENCING: pedidos_detalle con clienteCodigo.</comment>
        <mongodb:createCollection collectionName="pedidos_detalle">
            <mongodb:options><![CDATA[{
                "validator": {"$jsonSchema": {
                    "bsonType": "object",
                    "required": ["numeroPedido", "clienteCodigo", "estado", "items"],
                    "properties": {
                        "numeroPedido":  {"bsonType": "string"},
                        "clienteCodigo": {"bsonType": "string"},
                        "estado": {
                            "bsonType": "string",
                            "enum": ["PENDIENTE", "CONFIRMADO", "EN_PROCESO", "DESPACHADO", "ENTREGADO", "CANCELADO"]
                        },
                        "items": {"bsonType": "array"}
                    }
                }},
                "validationLevel": "moderate"
            }]]></mongodb:options>
        </mongodb:createCollection>
        <rollback><mongodb:dropCollection collectionName="pedidos_detalle"/></rollback>
    </changeSet>

    <changeSet id="V003-07" author="avsa-t08">
        <preConditions onFail="MARK_RAN">
            <not><mongodb:collectionExists collectionName="audit_logs_v2"/></not>
        </preConditions>
        <comment>REFERENCING: audit_logs_v2 con modulo + entidadId.</comment>
        <mongodb:createCollection collectionName="audit_logs_v2"/>
        <rollback><mongodb:dropCollection collectionName="audit_logs_v2"/></rollback>
    </changeSet>

    <!-- ============================================================
         ÃNDICES
         ============================================================ -->

    <changeSet id="V003-08" author="avsa-t08">
        <comment>Ãndices de las colecciones V003.</comment>
        <mongodb:createIndex collectionName="productos_v2">
            <mongodb:keys>{"codigo": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_productos_v2_codigo", "unique": true}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="customer_v2">
            <mongodb:keys>{"codigo": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_customer_v2_codigo", "unique": true}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="notificaciones_v2">
            <mongodb:keys>{"snapshot.productorCodigo": 1, "fechaHora": -1}</mongodb:keys>
            <mongodb:options>{"name": "idx_notif_v2_productor_fecha"}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="fabricantes">
            <mongodb:keys>{"codigo": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_fabricantes_codigo", "unique": true}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="agrochemicals_v2">
            <mongodb:keys>{"fabricanteCodigo": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_agro_v2_fabricante"}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="pedidos_detalle">
            <mongodb:keys>{"numeroPedido": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_pedidos_numero", "unique": true}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="pedidos_detalle">
            <mongodb:keys>{"clienteCodigo": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_pedidos_cliente"}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="audit_logs_v2">
            <mongodb:keys>{"modulo": 1, "entidadId": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_audit_v2_modulo_entidad"}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="audit_logs_v2">
            <mongodb:keys>{"timestamp": -1}</mongodb:keys>
            <mongodb:options>{"name": "idx_audit_v2_timestamp"}</mongodb:options>
        </mongodb:createIndex>
        <mongodb:createIndex collectionName="audit_logs_v2">
            <mongodb:keys>{"userName": 1}</mongodb:keys>
            <mongodb:options>{"name": "idx_audit_v2_user"}</mongodb:options>
        </mongodb:createIndex>
        <rollback>
            <mongodb:dropIndex collectionName="productos_v2"><mongodb:keys>{"codigo": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="customer_v2"><mongodb:keys>{"codigo": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="notificaciones_v2"><mongodb:keys>{"snapshot.productorCodigo": 1, "fechaHora": -1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="fabricantes"><mongodb:keys>{"codigo": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="agrochemicals_v2"><mongodb:keys>{"fabricanteCodigo": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="pedidos_detalle"><mongodb:keys>{"numeroPedido": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="pedidos_detalle"><mongodb:keys>{"clienteCodigo": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="audit_logs_v2"><mongodb:keys>{"modulo": 1, "entidadId": 1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="audit_logs_v2"><mongodb:keys>{"timestamp": -1}</mongodb:keys></mongodb:dropIndex>
            <mongodb:dropIndex collectionName="audit_logs_v2"><mongodb:keys>{"userName": 1}</mongodb:keys></mongodb:dropIndex>
        </rollback>
    </changeSet>

