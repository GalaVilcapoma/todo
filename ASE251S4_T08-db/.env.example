# =============================================================
# .env.example — AVSA Cañete — Equipo 08
# Copia este archivo como .env y ajusta las credenciales.
# Nunca confirmes .env en Git.
# =============================================================

# --- Identidad de imágenes ---
IMAGE_NAMESPACE=avsa-t08
RELEASE_VERSION=local

# --- SQL Server ---
MSSQL_SA_PASSWORD=Avsa@Admin12345
MSSQL_PID=Express
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=avsa_db

# --- MongoDB ---
# El compose local corre MongoDB SIN autenticación (patrón de
# desarrollo). Las siguientes variables solo las usa la imagen
# legacy mongodb/run.sh, que sí crea un usuario root.
MONGODB_PORT=27017
MONGODB_DATABASE=db_avsa
MONGODB_REPLICA_SET=rs0
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=Avsa@Admin12345
